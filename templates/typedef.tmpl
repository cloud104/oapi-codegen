{{$types := .Types -}}
{{range .Types -}}
{{.DocComment}}
type {{.TypeName}} {{if .IsAlias}}={{end}} {{.Schema.TypeDecl}}
{{if and (not .IsAlias) .Schema.Properties}}
func (v *{{.TypeName}}) HasReadOnlyChanges(patch map[string]any) bool {
	{{- range $property := .Schema.Properties}}
	{{- $type := $property.GoTypeDef}}
	{{- $field := $property.GoFieldName}}
	{{- $json := $property.JsonFieldName}}
	{{- $base := trimPrefix "*" $type}}
	{{- if $property.ReadOnly}}
	if value, exists := patch["{{$json}}"]; exists {
		{{- if or (eq $type "*int") (eq $type "*int32") (eq $type "*int64")}}
		if value == nil {
			if v.{{$field}} != nil {
				return true
			}
		} else {
			number, ok := value.(float64)
			if !ok || v.{{$field}} == nil || number != float64(*v.{{$field}}) {
				return true
			}
		}
		{{- else if or (eq $type "int") (eq $type "int32") (eq $type "int64")}}
		number, ok := value.(float64)
		if !ok || number != float64(v.{{$field}}) {
			return true
		}
		{{- else if or (eq $type "*float32") (eq $type "*float64")}}
		if value == nil {
			if v.{{$field}} != nil {
				return true
			}
		} else {
			number, ok := value.(float64)
			if !ok || v.{{$field}} == nil || {{$base}}(number) != *v.{{$field}} {
				return true
			}
		}
		{{- else if or (eq $type "float32") (eq $type "float64")}}
		number, ok := value.(float64)
		if !ok || {{$type}}(number) != v.{{$field}} {
			return true
		}
		{{- else if eq $type "*string"}}
		if value == nil {
			if v.{{$field}} != nil {
				return true
			}
		} else {
			str, ok := value.(string)
			if !ok || v.{{$field}} == nil || str != *v.{{$field}} {
				return true
			}
		}
		{{- else if eq $type "string"}}
		str, ok := value.(string)
		if !ok || str != v.{{$field}} {
			return true
		}
		{{- else if eq $type "*bool"}}
		if value == nil {
			if v.{{$field}} != nil {
				return true
			}
		} else {
			b, ok := value.(bool)
			if !ok || v.{{$field}} == nil || b != *v.{{$field}} {
				return true
			}
		}
		{{- else if eq $type "bool"}}
		b, ok := value.(bool)
		if !ok || b != v.{{$field}} {
			return true
		}
		{{- else}}
		_ = value
		return true
		{{- end}}
	}
	{{- else}}
	{{- range $model := $types}}
	{{- if and (not $model.IsAlias) $model.Schema.Properties (eq $base $model.TypeName)}}
	if value, exists := patch["{{$json}}"]; exists {
		if value == nil {
			{{- if eq $type (printf "*%s" $base)}}
			if v.{{$field}} != nil {
				return true
			}
			{{- else}}
			return true
			{{- end}}
		} else {
			nested, ok := value.(map[string]any)
			if !ok {
				return true
			}
			{{- if eq $type (printf "*%s" $base)}}
			if v.{{$field}}.HasReadOnlyChanges(nested) {
				return true
			}
			{{- else}}
			if (&v.{{$field}}).HasReadOnlyChanges(nested) {
				return true
			}
			{{- end}}
		}
	}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- end}}
	return false
}
{{end -}}
{{end -}}

type {{$name}}ResponseBuilder struct {
    writer http.ResponseWriter
    request *http.Request
    {{ range $resp.Bodies -}}
    {{.GoName | goCamelCase }} *{{ .Type }}
    {{ end -}}
}

{{range $resp.Bodies}}
func (b *{{$name}}ResponseBuilder) {{ .GoName }}({{.GoName | goCamelCase }} {{.Type}}) error {
	b.{{.GoName | goCamelCase }} = &{{.GoName | goCamelCase }}
	return nil
}
{{end}}

func (b *{{$name}}ResponseBuilder) Build() error {
    contentTypes := []string{
        {{- range $resp.Bodies }}
            {{- range .ContentTypes }}
                {{ . | quote }},
            {{- end }}
        {{- end }}
    }

	contentType := negotiate.ContentType(
		b.request,
		contentTypes,
		"",
	)

	if contentType == "" {
		http.Error(b.writer, http.StatusText(http.StatusNotAcceptable), http.StatusNotAcceptable)
		return nil
	}

	var (
		body []byte
		err  error
	)


    {{- $bodies := $resp.Bodies }}

    selected := false

    {{ range $bodies }}
    {{- $field := .GoName | goCamelCase }}
    if !selected && b.{{ $field }} != nil &&
       (false{{ range .ContentTypes }} || contentType == {{ . | quote }}{{ end }}) {
       selected = true

       switch contentType {
       case "application/json":
          body, err = json.Marshal(b.{{ $field }})

       case "application/xml":
          body, err = xml.Marshal(b.{{ $field }})

       default:
          return fmt.Errorf("unsupported content type: %s", contentType)
       }
    }
    {{ end }}

    if !selected {
       return fmt.Errorf("no response body provided for content type %s", contentType)
    }

    if err != nil {
       return fmt.Errorf("marshal response: %w", err)
    }

	b.writer.Header().Set("Content-Type", contentType)
	b.writer.Header().Add("Vary", "Accept")
    b.writer.WriteHeader({{$resp.GoName}})

    _, err = b.writer.Write(body)
    return err
}
{{ end }}

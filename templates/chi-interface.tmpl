// ({{.Method}} {{.Path}})
{{with .DeprecationComment}}//
{{.}}
{{end}}{{.OperationId}}(ctx context.Context, response {{.OperationId}}ResponseBuilder{{genParamArgs .PathParams}}{{if .RequiresParamObject}}, params {{.OperationId}}Params{{end}}{{genJSONRequestBodyArg .}}) error
{{end}}{{end}}
}

{{range .}}{{if not .IsAlias}}
type {{.OperationId}}ResponseBuilder struct {
    writer http.ResponseWriter
    request *http.Request
}

{{$opid := .OperationId -}}
{{ range getResponses . }}{{$resp := . -}}
{{$name := printf "%s%d" $opid $resp.Code }}

func (l *{{$opid}}ResponseBuilder) {{.Name}}() *{{$name}}ResponseBuilder {
    return &{{$name}}ResponseBuilder{
        writer:  l.writer,
        request: l.request,
    }
}

type {{$name}}ResponseBuilder struct {
    writer http.ResponseWriter
    request *http.Request
    {{ range $resp.Bodies -}}
    {{.GoName | goCamelCase }} *{{ .Type }}
    {{ end -}}
}

{{range $resp.Bodies}}
func (b *{{$name}}ResponseBuilder) {{ .GoName }}({{.GoName | goCamelCase }} {{.Type}}) error {
	b.{{.GoName | goCamelCase }} = &{{.GoName | goCamelCase }}
	return nil
}
{{end}}

func (b *{{$name}}ResponseBuilder) Build() error {
    contentType := negotiate.ContentType(b.request, []string{
        {{- range $resp.Bodies }}
            {{- range .ContentTypes }}
        {{ . | quote }},
            {{- end }}
        {{- end }}
    }, "")

    if contentType == "" {
        http.Error(b.writer, http.StatusText(http.StatusNotAcceptable), http.StatusNotAcceptable)
        return nil
    }

    var (
        body []byte
        err  error
    )

    switch {
    {{- range $resp.Bodies }}
        {{- $field := .GoName | goCamelCase }}
        {{- range .ContentTypes }}
    case contentType == {{ . | quote }} && b.{{$field}} != nil:
            {{- if or
                (eq . "application/json")
                (eq . "text/x-json")
                (eq . "application/problem+json")
                (eq . "application/hal+json")
            }}
        body, err = json.Marshal(b.{{$field}})
            {{- else if or
                (eq . "application/yaml")
                (eq . "application/x-yaml")
                (eq . "text/yaml")
                (eq . "text/x-yaml")
            }}
        body, err = yaml.Marshal(b.{{$field}})
            {{- else if or
                (eq . "application/xml")
                (eq . "text/xml")
                (eq . "application/problem+xml")
            }}
        body, err = xml.Marshal(b.{{$field}})
            {{- else }}
        return fmt.Errorf("unsupported response content type: %s", contentType)
            {{- end }}
        {{- end }}
    {{- end }}
    default:
        return fmt.Errorf("no response body provided for content type %s", contentType)
    }

    if err != nil {
        return fmt.Errorf("marshal response: %w", err)
    }

    b.writer.Header().Set("Content-Type", contentType)
    b.writer.Header().Add("Vary", "Accept")
    b.writer.WriteHeader({{$resp.GoName}})

    _, err = b.writer.Write(body)
    return err
}
{{ end }}
{{end}}{{end}}


// SchemaRegistry manages registered JSON schemas.
type SchemaRegistry struct {
	compiler *jsonschema.Compiler
	schemas  map[string]*jsonschema.Schema
}

func NewSchemaRegistry() *SchemaRegistry {
	compiler := jsonschema.NewCompiler()
	compiler.AssertFormat()

	return &SchemaRegistry{
		compiler: compiler,
		schemas:  make(map[string]*jsonschema.Schema),
	}
}

// Register parses, compiles, and stores a JSON schema under the given name.
func (r *SchemaRegistry) Register(name, source string) error {
	doc, err := jsonschema.UnmarshalJSON(strings.NewReader(source))
	if err != nil {
		return fmt.Errorf("parse JSON schema %q: invalid JSON document: %w", name, err)
	}

	if err := r.compiler.AddResource(name, doc); err != nil {
		return fmt.Errorf("register JSON schema %q: unable to add resource: %w", name, err)
	}

	schema, err := r.compiler.Compile(name)
	if err != nil {
		return fmt.Errorf("compile JSON schema %q: invalid definitions or unresolved references: %w", name, err)
	}

	r.schemas[name] = schema
	return nil
}

// Validator returns a validator for a registered schema.
func (r *SchemaRegistry) Validator(name string) (*SchemaValidator, error) {
	schema, exists := r.schemas[name]
	if !exists {
		return nil, fmt.Errorf("JSON schema %q is not registered", name)
	}

	return &SchemaValidator{schema: schema}, nil
}

// SchemaValidator validates JSON data against a compiled schema.
type SchemaValidator struct {
	schema *jsonschema.Schema
}

// Validate checks JSON data against the validator's schema.
func (v *SchemaValidator) Validate(data io.Reader) error {
	value, err := jsonschema.UnmarshalJSON(data)
	if err != nil {
		return fmt.Errorf("invalid JSON: %w", err)
	}

	if err := v.schema.Validate(value); err != nil {
		validationErr, ok := errors.AsType[*jsonschema.ValidationError](err)
		if !ok {
			return fmt.Errorf("invalid JSON: %w", err)
		}

		return errors.New(formatValidationError(validationErr))
	}

	return nil
}

// formatValidationError converts validation errors into human-readable messages.
func formatValidationError(err *jsonschema.ValidationError) (result string) {
	defer func() {
		result = strings.TrimSpace(result)
	}()

	// Recursively format nested validation errors.
	if len(err.Causes) > 0 {
		messages := make([]string, 0, len(err.Causes))

		for _, cause := range err.Causes {
			messages = append(messages, formatValidationError(cause))
		}

		return strings.Join(messages, "; ")
	}

	// Identify the field where validation failed.
	field := strings.Join(err.InstanceLocation, ".")

	// Generate a message based on the validation error type.
	switch rule := err.ErrorKind.(type) {
	case *kind.Required:
		if len(rule.Missing) == 1 {
			return fmt.Sprintf("%s %s is required", field, rule.Missing[0])
		}
		return fmt.Sprintf("%s missing required fields %s", field, strings.Join(rule.Missing, ", "))

	case *kind.Type:
		if len(rule.Want) == 1 {
			return fmt.Sprintf("%s must be %s (got %s)", field, rule.Want[0], rule.Got)
		}
		return fmt.Sprintf("%s must be one of %s (got %s)", field, strings.Join(rule.Want, ", "), rule.Got)

	case *kind.MinLength:
		if rule.Want == 1 {
			return fmt.Sprintf("%s cannot be empty", field)
		}
		return fmt.Sprintf("%s must contain at least %d characters", field, rule.Want)

	case *kind.MaxLength:
		if rule.Want == 1 {
			return fmt.Sprintf("%s must be a single character", field)
		}
		return fmt.Sprintf("%s must contain no more than %d characters", field, rule.Want)

	case *kind.Minimum:
		return fmt.Sprintf("%s must be at least %s", field, rule.Want.FloatString(2))

	case *kind.Maximum:
		return fmt.Sprintf("%s must not exceed %s", field, rule.Want.FloatString(2))

	case *kind.Pattern:
		return fmt.Sprintf("%s does not match the required pattern", field)

	case *kind.Format:
		return fmt.Sprintf("%s must be a valid %s", field, rule.Want)

	case *kind.Enum:
		values := make([]string, 0, len(rule.Want))

		for _, value := range rule.Want {
			values = append(values, fmt.Sprint(value))
		}

		if len(values) == 1 {
			return fmt.Sprintf("%s must be %s", field, values[0])
		}
		return fmt.Sprintf("%s must be one of %s", field, strings.Join(values, ", "))

	default:
		// Use the library's localized message for other error types.
		if err.ErrorKind != nil {
			printer := message.NewPrinter(language.English)
			return fmt.Sprintf("%s %s", field, err.ErrorKind.LocalizedString(printer))
		}

		return fmt.Sprintf("%s is invalid", field)
	}
}

